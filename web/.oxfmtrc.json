{
	"$schema": "./node_modules/oxfmt/configuration_schema.json",
	"useTabs": true,
	"singleQuote": true,
	"trailingComma": "none",
	"printWidth": 100,
	"endOfLine": "lf",
	"svelte": true,
	"sortTailwindcss": true,
	"embeddedLanguageFormatting": "auto",
	"ignorePatterns": ["build/**", ".svelte-kit/**", "node_modules/**"]
}
