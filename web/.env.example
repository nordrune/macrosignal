# Litestar API origin, used by Vite dev proxy and hooks.server.ts in prod
API_ORIGIN=http://127.0.0.1:41793

# Optional in-app assistant. Create an API key in Google AI Studio.
# If no key is set, the assistant falls back to Vertex AI through Google ADC.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite

# Optional for ADC/Vertex AI. gcloud ADC can also provide quota_project_id automatically.
# GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/service-account-or-adc.json
# GOOGLE_CLOUD_PROJECT=your-google-cloud-project-id
# VERTEX_PROJECT_ID=your-google-cloud-project-id
# VERTEX_LOCATION=us-central1
# VERTEX_MODEL=gemini-2.5-flash-lite
